{
  "name": "personal-notes-backend",
  "version": "1.0.0",
  "description": "个人笔记系统后端 API（Express + SQLite + JWT），支持打包为桌面离线 EXE",
  "main": "start-app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build-exe": "pkg start-app.js --targets node24-win-x64 --output ../dist/PersonalNotes.exe"
  },
  "keywords": [
    "notes",
    "express",
    "sqlite"
  ],
  "license": "MIT",
  "dependencies": {
    "@webviewjs/webview": "^0.1.4",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "assets": [
      ".env",
      "node_modules/better-sqlite3/prebuilds/win32-x64.node",
      "node_modules/@webviewjs/webview-win32-x64-msvc/webview.win32-x64-msvc.node",
      "../frontend/**/*"
    ],
    "scripts": ["./server.js"]
  }
}
